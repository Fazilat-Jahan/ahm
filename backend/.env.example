MODE=LOCAL_ONLY
# Local/offline (LOCAL_ONLY / HABITAT_LAN): a SQLite file, no internet needed.
DATABASE_URL=sqlite+aiosqlite:///./ahm.db
# Ground sync (GROUND_SYNC), Neon Postgres. Paste the Neon string as given;
# "sslmode=require" is translated for the asyncpg driver automatically.
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/db?sslmode=require

# Signs the login tokens. CHANGE THIS before any real use: with the default
# value anyone can forge a token for any role.
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=720

# Exact browser origins allowed to call the API (the frontend runs on 3100).
CORS_ORIGINS=http://localhost:3100
# Origins on this machine or a private LAN (192.168.x.x, 10.x.x.x,
# 172.16-31.x.x), any port, are also allowed by default. To allow ONLY the
# CORS_ORIGINS list, uncomment the next line:
# CORS_ORIGIN_REGEX=

# Shared key for device sync (/sync/push, /sync/pull). Type the same value
# into the Sync screen of each trusted device. Leave empty to switch sync
# off. Anyone with this key can read and write every astronaut's records,
# so use a long random value.
SYNC_KEY=
